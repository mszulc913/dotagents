{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "extends": "dev-nono",
  "meta": {
    "name": "dev-nono-gpu",
    "version": "1.0.0",
    "description": "dev-nono with CUDA; AF_UNIX sockets (docker, D-Bus) stay reachable"
  },
  "allow_gpu": true,
  "filesystem": {
    "read": [
      "/usr/local/cuda*"
    ]
  },
  "linux": {
    "af_unix_mediation": "off"
  }
}
