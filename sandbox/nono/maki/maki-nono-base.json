{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "meta": {
    "name": "maki-nono-base",
    "version": "1.0.0",
    "description": "Maki runtime paths, shared by maki-nono and maki-nono-gpu"
  },
  "filesystem": {
    "allow": [
      "$XDG_CACHE_HOME/maki"
    ],
    "read": [
      "$XDG_CONFIG_HOME/maki"
    ],
    "allow_file": [
      "$XDG_CONFIG_HOME/maki/pack-lock.json.lock"
    ]
  },
  "environment": {
    "allow_vars": [
      "MAKI_LOG",
      "MAKI_TRUECOLOR",
      "MAKI_DISABLE_AUTOCOMPACT"
    ]
  },
  "network": {
    "allow_domain": [
      "models.dev",
      "auth.openai.com",
      "chatgpt.com"
    ],
    "listen_port": [1455]
  }
}
