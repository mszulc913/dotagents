{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "extends": ["dev-nono-gpu", "chrome-nono-base", "maki-nono-base"],
  "meta": {
    "name": "maki-nono-gpu",
    "version": "1.0.0",
    "description": "Maki with CUDA and host state; real credentials, AF_UNIX sockets stay reachable"
  },
  "filesystem": {
    "allow": [
      "$XDG_STATE_HOME/maki"
    ]
  },
  "env_credentials": {
    "openrouter_api_key": "OPENROUTER_API_KEY"
  }
}
